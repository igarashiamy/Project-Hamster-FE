# Copy this file to .env.local and fill in the values from the PROTOTYPE
# Supabase project: Project Settings -> API Keys (publishable key) and the
# Project URL.
#
# On Vercel, add the same two names under Settings -> Environment Variables,
# then redeploy. These values are baked in when the site is built.
#
# Do NOT add the Gemini key here. It belongs in Supabase:
# Edge Functions -> Secrets -> GEMINI_API_KEY.
VITE_SUPABASE_URL=https://your-new-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
